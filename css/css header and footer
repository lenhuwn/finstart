            <a href="..\pages\Chính sách bảo mật\điều khoản sử dụng.html" target="_blank">Điều khoản sử dụng</a>
            <a href="..\pages\Chính sách bảo mật\quy chuẩn mã hóa tài chính.html" target="_blank">Quy chuẩn mã hóa tài chính</a>
            <a href="..\pages\Chính sách bảo mật\hỗ trợ.html" target="_blank">Hỗ trợ 24/7</a>
