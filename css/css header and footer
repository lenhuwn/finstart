<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FinStart</title>
    
    <style>
        /* ================= CÀI ĐẶT CƠ BẢN ================= */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa; 
        }

        a {
            text-decoration: none;
        }

        /* ================= HEADER STYLE ================= */
        header {
            background-color: #ffffff;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
            padding: 16px 48px;
            display: flex;
            justify-content: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            max-width: 1200px;
        }

        .header .logo img {
            height: 32px;
            width: auto;
            display: block;
        }

        .header nav {
            display: flex;
            gap: 32px;
        }

        .header nav a {
            color: #6c757d;
            font-weight: 500;
            font-size: 15px;
            transition: color 0.2s ease;
        }

        .header nav a:hover {
            color: #121826;
        }

        .header nav a[href="tính năng.html"] {
            color: #07a75c;
            font-weight: 600;
        }

        .header > div:last-child {
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .header > div:last-child a[href="đăng nhập.html"] {
            color: #121826;
            font-weight: 600;
            font-size: 15px;
        }

        .header > div:last-child a[href="đăng ký.html"] {
            background-color: #121826;
            color: #ffffff;
            padding: 10px 24px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 15px;
            transition: background-color 0.2s ease;
        }

        .header > div:last-child a[href="đăng ký.html"]:hover {
            background-color: #2c3344;
        }

        .header > div:last-child::after {
            content: '\1F464';
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            background-color: #121826;
            color: #ffffff;
            border-radius: 50%;
            font-size: 16px;
            cursor: pointer;
        }

        /* ================= FOOTER STYLE ================= */
        footer {
            background-color: #1a1f2e;
            color: #9ca3af;
            padding: 60px 8%;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 40px;
            flex-wrap: wrap;
            margin-top: 50px;
        }

        footer .footer {
            flex: 1.5;
            min-width: 280px;
        }

        footer .footer .logo {
            margin-bottom: 24px;
        }

        footer .footer .logo img {
            height: 32px;
            width: auto;
            filter: brightness(0) invert(1); 
        }

        footer .footer p {
            font-size: 14px;
            line-height: 1.6;
            margin-bottom: 24px;
        }

        footer .footer-menu, 
        footer .footer-policy, 
        footer .footer-contact {
            flex: 1;
            min-width: 180px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        footer h3 {
            color: #ffffff;
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 12px;
        }

        footer a {
            color: #9ca3af;
            font-size: 14px;
            transition: color 0.2s ease;
        }

        footer a:hover {
            color: #ffffff;
        }

        footer .footer-contact p {
            font-size: 14px;
            margin-bottom: 6px;
        }

        footer .footer-contact a {
            color: #ffffff;
            font-weight: 500;
        }
    </style>
</head>
<body>

